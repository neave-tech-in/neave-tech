# Gmail address used to send contact-form emails
SMTP_USER=yourgmail@gmail.com

# Google Account App Password (not your normal Gmail password)
SMTP_PASS=your-16-character-app-password

# Inbox that receives website inquiries
RECIPIENT_EMAIL=yourgmail@gmail.com

# HubSpot private app access token with Contacts write permission
HUBSPOT_ACCESS_TOKEN=pat-na1-your-private-app-token
